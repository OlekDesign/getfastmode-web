---
---

<section class="hero" aria-label="Hero">
  <div class="container hero__inner">
    <h1 class="hero__heading">
      You already fast every night.<br />FastMode makes it count.
    </h1>
    <p class="hero__sub">
      A simple intermittent fasting tracker that shows what your body is doing — hour by hour. Free to start.
    </p>
    <a
      href="https://apps.apple.com/pl/app/fastmode-intermittent-fasting/id6760288550"
      class="hero__cta"
      data-get-app
      aria-label="Download FastMode free"
    >
      Download Free
    </a>
    <div class="hero__card">
      <img
        src="/fastmode-iphone.png"
        class="hero__app-img"
        alt="FastMode app — ring timer showing fasting phase"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 128px;
    padding-bottom: 24px;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .hero__heading {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 38px;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: 16px;
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-align: center;
    max-width: 420px;
    margin-bottom: 24px;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 14px 24px;
    border-radius: 9999px;
    background: #1E1B18;
    color: #F7EFE9;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 40px;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .hero__cta:hover { opacity: 0.85; }
  .hero__cta:active { transform: scale(0.97); }

  .hero__cta:focus-visible {
    outline: 2px solid #1E1B18;
    outline-offset: 3px;
  }

  .hero__card {
    border-radius: 24px;
    overflow: hidden;
    padding: 32px 0 32px;
    background: url('/patterns-circles.jpg') center / cover no-repeat;
    box-shadow: 0px 24px 20px -14px rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
  }

  .hero__app-img {
    width: 87.7%;
    max-width: 342px;
    height: auto;
    display: block;
    flex-shrink: 0;
  }
</style>
